# MCP server for the verified concurrency queries, HTTP transport.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "mcp>=1.9" uvicorn starlette
COPY scripts/ scripts/
COPY sql/ sql/
ENV PYTHONUNBUFFERED=1
EXPOSE 8765
CMD ["python", "scripts/mcp_server.py", "--http", "--port", "8765"]
