# Copy to .env.edge next to edge-compose.yml and fill in. Nothing here is
# optional at runtime; the compose file refuses to start without the
# ":?set in .env.edge" ones.

# ClickHouse Cloud (the analytics service the MCP tools query)
CH_HOST=<your-service>.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=<redacted>
CH_DB=sony

# Gemini API key (LibreChat direct endpoint + LiteLLM proxy)
GOOGLE_KEY=<redacted>

# LibreChat credential encryption (any 64/32-char hex pair)
LIBRECHAT_CREDS_KEY=<64 hex chars>
LIBRECHAT_CREDS_IV=<32 hex chars>

# LiteLLM proxy master key (LibreChat + decline-watch authenticate with this)
LITELLM_MASTER_KEY=<redacted>

# Langfuse headless bootstrap: org/project/login/API keys exist from first boot
LANGFUSE_ENCRYPTION_KEY=<64 hex chars>
LANGFUSE_PUBLIC_URL=http://<vm-ip>:3000
LANGFUSE_PK=pk-lf-<hex>
LANGFUSE_SK=sk-lf-<hex>
LANGFUSE_USER_EMAIL=<login email>
LANGFUSE_USER_PASSWORD=<redacted>

# HyperDX public URL (auth redirects break if left at localhost)
CLICKSTACK_PUBLIC_URL=http://<vm-ip>:8080
