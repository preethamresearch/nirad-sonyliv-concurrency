.env
*.pyc
__pycache__/
.venv/
venv/

# Raw datasets are distributed via the organisers' Git LFS repo, not vendored here.
data/*.csv
data/*.parquet

# Generated run artefacts are kept, but scratch is not.
out/scratch/
*.log

# Generated test fixtures. Large, and reproducible from the source dataset:
#   python scripts/make_fixture.py --raw <raw.csv> --out fixtures/open_day.csv --cut-minutes-before-end 30
fixtures/*.csv

# Scratch produced while restructuring the UI shell.
web/_shell.html
web/*.backup.html

# Internal working notes and agent handover -- not submission material.
CLAUDE.md
docs/REMARKS.md
scripts/_check_oracle_parallel.py

# Image preprocessing is done locally; only the output asset ships.
scripts/prep_logo.py
web/shots/*-source.*
web/shots/sony.png

# Playwright browsers and pytest cache
.pytest_cache/
test-results/
.env.edge
infra/.env.edge
