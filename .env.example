# Copy to .env and fill in. Never commit .env.
# ClickHouse Cloud: host is <id>.<region>.<provider>.clickhouse.cloud, port 8443, secure.
# Local Docker fallback: host=localhost port=8123 secure=0 user=default password=hack

CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=hack
CH_SECURE=0
CH_DB=sony

# ClickStack / HyperDX. Get the ingestion key from HyperDX Team Settings,
# or read it straight out of the container:
#   docker exec -w /app clickstack node -e "..."   (see docs/DESIGN.md)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=authorization=<hyperdx-ingestion-key>
OTEL_SERVICE_NAME=nirad-concurrency
